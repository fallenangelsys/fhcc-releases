# ===============================================
# Core
# ===============================================
NODE_ENV=production
DISCORD_TOKEN=PASTE_YOUR_TOKEN_HERE
DISCORD_CLIENT_ID=PASTE_YOUR_CLIENT_ID
DISCORD_CLIENT_SECRET=PASTE_YOUR_CLIENT_SECRET

# ===============================================
# Dashboard Security
# ===============================================
DASHBOARD_SESSION_SECRET=replace-with-random-64-char-secret
DASHBOARD_PORT=3000
# Exakt dieselbe URI im Discord Developer Portal unter OAuth2 -> Redirects eintragen:
DASHBOARD_DISCORD_REDIRECT_URI=http://127.0.0.1:3000/api/auth/discord/callback

# ===============================================
# Runtime
# ===============================================
DASHBOARD_JWT_TTL=30d

# ===============================================
# Signierte Desktop-Updates (optional)
# ===============================================
# Muss auf einen HTTPS-Ordner mit latest.yml und signiertem NSIS-Installer zeigen.
FALLEN_HEAVEN_UPDATE_URL=
